---
/* Markup ported verbatim from "Adnan Main Portfolio.html" lines 6305-6353.
   Class names, ids and data-* attributes are load-bearing for the ported
   scripts in src/scripts -- do not rename. */
---
<!-- =========================================================
   INTERSECTION OBSERVER
   ========================================================= -->

<!-- ============ B2B & CHANNEL MARKETING ============ -->
<section class="b2b-channel" id="b2b-channel" data-io="once" data-io-threshold="0.18" data-io-enter="b2bReveal" aria-labelledby="b2b-channel-title">
  <div class="b2b-channel__inner">
    <header class="b2b-channel__header b2b-reveal">
      <p class="b2b-channel__kicker">B2B CHANNEL MARKETING</p>
      <h2 class="b2b-channel__title" id="b2b-channel-title">B2B &amp; Channel <span>Marketing</span></h2>
    </header>

    <div class="b2b-ecosystem b2b-reveal" id="b2bEcosystem">
      <div class="b2b-network" aria-label="B2B channel marketing flow">
        <div class="b2b-horizontal-flow">
          <div class="b2b-flow-node" tabindex="0">
            <span class="b2b-flow-node__index">Vendor</span>
            <span class="b2b-flow-node__title">VENDOR</span>
            <span class="b2b-flow-node__desc">Technology / Brand</span>
          </div>
          <span class="b2b-flow-arrow" aria-hidden="true"></span>
          <div class="b2b-flow-node" tabindex="0">
            <span class="b2b-flow-node__index">Channel</span>
            <span class="b2b-flow-node__title">DISTRIBUTOR</span>
            <span class="b2b-flow-node__desc">Portfolio / Channel</span>
          </div>
          <span class="b2b-flow-arrow" aria-hidden="true"></span>
          <div class="b2b-flow-node" tabindex="0">
            <span class="b2b-flow-node__index">Partner</span>
            <span class="b2b-flow-node__title">PARTNER / RESELLER</span>
            <span class="b2b-flow-node__desc">Enablement / Demand</span>
          </div>
          <span class="b2b-flow-arrow" aria-hidden="true"></span>
          <div class="b2b-flow-node" tabindex="0">
            <span class="b2b-flow-node__index">Sales</span>
            <span class="b2b-flow-node__title">SALES TEAM</span>
            <span class="b2b-flow-node__desc">Leads / Insights</span>
          </div>
          <span class="b2b-flow-arrow" aria-hidden="true"></span>
          <div class="b2b-flow-node" tabindex="0">
            <span class="b2b-flow-node__index">Customer</span>
            <span class="b2b-flow-node__title">END CUSTOMER</span>
            <span class="b2b-flow-node__desc">Demand / Conversion</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
