---
/* Markup ported verbatim from "Adnan Main Portfolio.html" lines 6494-6626.
   Class names, ids and data-* attributes are load-bearing for the ported
   scripts in src/scripts -- do not rename. */
---
<!-- ============ EXPERIENCE ============ -->
<!-- Heading levels are h2 / h3 on purpose: this block is designed to be merged
     into the single-page portfolio, where the hero section already owns the H1. -->
<section class="exp-section" id="experience" aria-labelledby="experience-title">
  <div class="exp-inner">

    <header class="exp-heading">
      <div>
        <div class="exp-eyebrow">05 &nbsp; EXPERIENCE</div>
        <h2 class="exp-title" id="experience-title">
          The path<br><span>behind the work.</span>
        </h2>
      </div>

      <p class="exp-intro">
        A career timeline that moves from web development into media operations,
        digital marketing, and today’s broader B2B technology marketing role.
      </p>
    </header>

    <div class="exp-stage" id="experienceStage">

      <svg class="exp-timeline-svg" viewBox="0 0 4 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="exp-line-bg" d="M2 0 V100" pathLength="1"></path>
        <path class="exp-line-progress" id="expLineProgress" d="M2 0 V100" pathLength="1"></path>
      </svg>

      <!-- 01 — CURRENT -->
      <article class="exp-item is-current">
        <div class="exp-node" aria-hidden="true"></div>

        <div class="exp-card">
          <div class="exp-meta">
            <span class="exp-period">Oct 2025 — Present</span>
            <span class="exp-current">Current</span>
            <span class="exp-index">01</span>
          </div>

          <h3 class="exp-role">Digital Marketing Executive</h3>

          <div class="exp-company-row">
            <div class="exp-company">
              <span>Gerab System Solutions · Dubai, UAE</span>
              <small class="exp-company-type">Enterprise IT Systems Integrator</small>
            </div>
            <div class="exp-company-logo">
              <img src="https://www.gerabnationalenterprises.com/wp-content/uploads/2022/11/Gerab-logo-1000x1000-1.png" alt="Gerab System Solutions logo" width="160" height="160" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <div class="exp-side-note" aria-hidden="true"><span class="exp-year">2025</span></div>
      </article>

      <!-- 02 -->
      <article class="exp-item">
        <div class="exp-node" aria-hidden="true"></div>

        <div class="exp-card">
          <div class="exp-meta">
            <span class="exp-period">Nov 2024 — Oct 2025</span>
            <span class="exp-index">02</span>
          </div>

          <h3 class="exp-role">Digital Marketing Coordinator</h3>

          <div class="exp-company-row">
            <div class="exp-company">
              <span>Simal Technologies Middle East LLC · Dubai, UAE</span>
            </div>
            <div class="exp-company-logo">
              <img src="https://www.simalme.com/wp-content/uploads/2024/12/cropped-cropped-Untitled_design__10_-removebg-preview.png" alt="Simal Technologies Middle East logo" width="160" height="160" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <div class="exp-side-note" aria-hidden="true"><span class="exp-year">2024</span></div>
      </article>

      <!-- 03 -->
      <article class="exp-item">
        <div class="exp-node" aria-hidden="true"></div>

        <div class="exp-card">
          <div class="exp-meta">
            <span class="exp-period">Aug 2023 — Sep 2024</span>
            <span class="exp-index">03</span>
          </div>

          <h3 class="exp-role">Digital Marketing Associate, Media Ops &amp; Management</h3>

          <div class="exp-company-row">
            <div class="exp-company">
              <span>Theorem Digital · Mysore, India</span>
              <small class="exp-company-type">Digital Marketing Agency</small>
            </div>
            <div class="exp-company-logo" data-plate="dark">
              <img src="https://theorem.digital/wp-content/uploads/2023/01/TheoremLogo-1.png" alt="Theorem Digital logo" width="160" height="160" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <div class="exp-side-note" aria-hidden="true"><span class="exp-year">2023</span></div>
      </article>

      <!-- 04 -->
      <article class="exp-item">
        <div class="exp-node" aria-hidden="true"></div>

        <div class="exp-card">
          <div class="exp-meta">
            <span class="exp-period">Jan 2023 — Apr 2023</span>
            <span class="exp-index">04</span>
          </div>

          <h3 class="exp-role">Web Developer Intern</h3>

          <div class="exp-company-row">
            <div class="exp-company">
              <span>VeriTech Software IT Services · Pune, India</span>
            </div>
            <div class="exp-company-logo">
              <img src="https://media.licdn.com/dms/image/v2/D4D0BAQEJNvn-8pzTmg/img-crop_100/B4DZ72ApWfKoAI-/0/1782243825307?e=1788998400&amp;v=beta&amp;t=gnyQzeyd1LXp9Wtnyq5r5QCR85bYsBkE3MRNlNo4NKA" alt="VeriTech Software IT Services logo" width="160" height="160" loading="lazy" decoding="async">
            </div>
          </div>
        </div>

        <div class="exp-side-note" aria-hidden="true"><span class="exp-year">2023</span></div>
      </article>

    </div>
  </div>
</section>
