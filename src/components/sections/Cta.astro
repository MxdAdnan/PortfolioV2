---
/* Markup ported verbatim from "Adnan Main Portfolio.html" lines 6786-6823.
   Class names, ids and data-* attributes are load-bearing for the ported
   scripts in src/scripts -- do not rename. */
---
<!-- ============ CTA ============ -->
<section class="cta" id="cta">
  <div class="cta__inner">

    <div class="cta__panel">

      <div class="cta__content">

        <div class="cta__eyebrow">
          LET'S WORK TOGETHER
        </div>

        <h1 class="cta__title">
          Let’s Build Something<br>
          That <span>Performs.</span>
        </h1>

        <p class="cta__copy">
          Have a project, campaign, website, or marketing challenge in mind?
          Let’s talk.
        </p>

        <div class="cta__actions">

          <button
            class="cta__button cta__button--primary"
            type="button"
            id="ctaOpenForm">
            Let’s Work Together
          </button>

        </div>

      </div>

    </div>
  </div>
</section>
