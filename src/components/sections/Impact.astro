---
/* Markup ported verbatim from "Adnan Main Portfolio.html" lines 5652-5723.
   Class names, ids and data-* attributes are load-bearing for the ported
   scripts in src/scripts -- do not rename. */
---
<!-- Placeholder next section, so the Hero exit has somewhere to hand off to -->

<!-- ============ MARKETING IMPACT ============ -->
<section class="impact" id="marketing-impact" data-io="toggle" data-io-threshold="0.12" data-io-enter="impactCounters" data-io-enter-ratio="0.28" data-io-safety="2500" aria-labelledby="impact-title">
  <div class="impact-inner">

    <header class="impact-heading">
      <div>
        <div class="eyebrow">Marketing Impact</div>
        <h2 id="impact-title">Built to create <span>impact.</span></h2>
      </div>

      <p class="intro">
        Digital marketing is more than activity. It is about creating measurable
        movement across <strong>visibility, acquisition, performance and growth.</strong>
      </p>
    </header>

    <div class="metrics">

      <article class="metric" data-target="3">
        <div class="number">0<span class="plus">+</span></div>
        <div>
          <div class="label">Years of Experience</div>
          <div class="detail">Professional digital marketing experience</div>
        </div>
      </article>

      <article class="metric" data-target="15">
        <div class="number">0<span class="plus">+</span></div>
        <div>
          <div class="label">Projects Delivered</div>
          <div class="detail">Web, SEO, campaigns and digital initiatives</div>
        </div>
      </article>

      <article class="metric" data-target="70">
        <div class="number">0<span class="plus">+</span></div>
        <div>
          <div class="label">Campaigns Managed</div>
          <div class="detail">Paid, organic and integrated marketing campaigns</div>
        </div>
      </article>

      <article class="metric" data-target="8">
        <div class="number">0<span class="plus">+</span></div>
        <div>
          <div class="label">Websites Developed</div>
          <div class="detail">WordPress and conversion-focused web experiences</div>
        </div>
      </article>

      <article class="metric" data-target="200000">
        <div class="number">0K<span class="plus">+</span></div>
        <div>
          <div class="label">AED Ad Spend Managed</div>
          <div class="detail">Performance advertising across digital platforms</div>
        </div>
      </article>

      <article class="metric" data-target="30">
        <div class="number">0<span class="suffix">%</span><span class="plus">+</span></div>
        <div>
          <div class="label">Organic SEO Growth</div>
          <div class="detail">Quarterly growth benchmark</div>
        </div>
      </article>

    </div>

  </div>
</section>
